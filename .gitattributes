# Store text files with LF in the repository; Git converts as needed.
* text=auto

# Windows scripts must keep CRLF line endings to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts must keep LF line endings.
mvnw text eol=lf
*.sh text eol=lf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.ttf binary
