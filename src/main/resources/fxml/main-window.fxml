<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Temporary window until the real screens arrive. Shows startup status. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.MainWindowController"
      styleClass="welcome"
      alignment="CENTER"
      spacing="12">

    <Label text="Virpe Mart" styleClass="title"/>
    <Label text="Billing software foundation is working." styleClass="subtitle"/>
    <!-- Marathi test line: proves Devanagari text renders. Means "Marathi names will appear here". -->
    <Label text="मराठी नावे येथे दिसतील" styleClass="subtitle"/>
    <Label fx:id="databaseLabel" styleClass="status"/>
    <Label fx:id="userLabel" styleClass="status"/>
    <Label fx:id="dataFolderLabel" styleClass="muted"/>
    <Label fx:id="versionLabel" styleClass="muted"/>
</VBox>
