<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Manage product categories. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.products.CategoriesController"
      styleClass="dialog"
      spacing="12"
      prefWidth="420"
      prefHeight="520">

    <Label text="Switched-off categories are hidden when choosing a category, but products keep them."
           styleClass="muted" wrapText="true" minHeight="-Infinity"/>

    <ListView fx:id="list" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="+ Add" styleClass="primary" onAction="#add"/>
        <Button fx:id="renameButton" text="Rename" onAction="#rename"/>
        <Button fx:id="toggleButton" text="Switch off" onAction="#toggle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" cancelButton="true" onAction="#close"/>
    </HBox>
</VBox>
