<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Customers screen: list on the left, the chosen customer's khata on the right. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.customers.CustomersController"
      fx:id="root"
      styleClass="page"
      spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Customers" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="duesTotalLabel" styleClass="dues-total"/>
        <Button text="+ Add customer" styleClass="primary" onAction="#addCustomer"/>
    </HBox>

    <SplitPane fx:id="split" VBox.vgrow="ALWAYS" dividerPositions="0.36">

        <!-- ============ left: customer list ============ -->
        <VBox spacing="8" styleClass="split-side">
            <TextField fx:id="searchField" styleClass="search-field"
                       promptText="Search by name, phone or number  (Ctrl+F)"/>
            <HBox spacing="14">
                <CheckBox fx:id="onlyDues" text="Only customers with dues"/>
                <CheckBox fx:id="showInactive" text="Show switched-off"/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="numberColumn" text="No." prefWidth="58"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="160"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="100"/>
                    <TableColumn fx:id="balanceColumn" text="Dues" prefWidth="95" styleClass="number-column"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="countLabel" styleClass="muted"/>
        </VBox>

        <!-- ============ right: chosen customer ============ -->
        <StackPane styleClass="split-side">
            <Label fx:id="nothingSelectedLabel" text="Choose a customer on the left to see their khata."
                   styleClass="muted"/>

            <VBox fx:id="detailPane" spacing="10" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="customerNameLabel" styleClass="detail-title" wrapText="true"/>
                        <Label fx:id="customerInfoLabel" styleClass="muted" wrapText="true" minHeight="-Infinity"/>
                        <Label fx:id="customerNotesLabel" styleClass="notes" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                    <Label fx:id="balanceLabel" styleClass="balance-box" minWidth="-Infinity"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="paymentButton" text="Receive payment" styleClass="primary" onAction="#receivePayment"/>
                    <Button text="Edit details" onAction="#editCustomer"/>
                    <Button fx:id="correctButton" text="Correct balance" onAction="#correctBalance"/>
                    <Button text="Bills" onAction="#showBills"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="toggleActiveButton" text="Switch off" onAction="#toggleActive"/>
                </HBox>

                <Label text="Khata" styleClass="section-title"/>
                <TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="128"/>
                        <TableColumn fx:id="detailsColumn" text="Details" prefWidth="200"/>
                        <TableColumn fx:id="addedColumn" text="Added" prefWidth="85" styleClass="number-column"/>
                        <TableColumn fx:id="paidColumn" text="Paid" prefWidth="85" styleClass="number-column"/>
                        <TableColumn fx:id="runningColumn" text="Balance" prefWidth="100" styleClass="number-column"/>
                        <TableColumn fx:id="byColumn" text="By" prefWidth="70"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </StackPane>
    </SplitPane>
</VBox>
