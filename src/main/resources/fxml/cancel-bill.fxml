<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Cancel a saved bill (owner): shows what will happen and asks for the reason. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.history.CancelBillController"
      styleClass="dialog"
      spacing="12"
      prefWidth="560">

    <Label fx:id="billLabel" styleClass="detail-title" wrapText="true" minHeight="-Infinity"/>

    <VBox styleClass="card" spacing="6">
        <Label text="What happens" styleClass="section-title"/>
        <Label fx:id="effectsLabel" wrapText="true" minHeight="-Infinity"/>
    </VBox>

    <Label text="Reason *"/>
    <TextField fx:id="reasonField" promptText="For example: wrong items, customer returned the goods"/>
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" minHeight="-Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Esc = keep the bill" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Keep the bill" cancelButton="true" onAction="#keep" minWidth="-Infinity"/>
        <Button text="Cancel this bill" styleClass="danger" onAction="#cancelBill" minWidth="-Infinity"/>
    </HBox>
</VBox>
