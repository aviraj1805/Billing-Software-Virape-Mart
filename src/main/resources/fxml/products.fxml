<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Products screen: search, filter and manage the product list. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.products.ProductsController"
      fx:id="root"
      styleClass="page"
      spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Products" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="categoriesButton" text="Categories…" onAction="#openCategories"/>
        <Button fx:id="importButton" text="Import from Excel…" onAction="#openImport"/>
        <Button fx:id="addButton" text="+ Add product" styleClass="primary" onAction="#addProduct"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" styleClass="search-field"
                   promptText="Search by name, Marathi name, pack size or code  (Ctrl+F)"/>
        <ComboBox fx:id="categoryFilter" prefWidth="230"/>
        <CheckBox fx:id="showInactive" text="Show switched-off"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" text="Code" prefWidth="70"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="185"/>
            <TableColumn fx:id="nameMrColumn" text="Marathi name" prefWidth="150"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="unitColumn" text="Sold by" prefWidth="120"/>
            <TableColumn fx:id="packColumn" text="Pack size" prefWidth="80"/>
            <TableColumn fx:id="rateColumn" text="Rate" prefWidth="125" styleClass="number-column"/>
            <TableColumn fx:id="mrpColumn" text="MRP" prefWidth="85" styleClass="number-column"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="105"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="countLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Edit" onAction="#editSelected"/>
        <Button fx:id="toggleActiveButton" text="Switch off" onAction="#toggleSelected"/>
        <Button fx:id="deleteButton" text="Delete" styleClass="danger" onAction="#deleteSelected"/>
    </HBox>
</VBox>
