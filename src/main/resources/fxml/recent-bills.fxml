<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Recent bills (F9 on the Billing screen): the newest bills, to see, print, correct or cancel. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.billing.RecentBillsController"
      fx:id="root"
      styleClass="dialog"
      spacing="10"
      prefWidth="900"
      prefHeight="600">

    <TextField fx:id="searchField" styleClass="search-field"
               promptText="Find an older bill: bill number, customer name or phone  (Ctrl+F)"/>
    <Label fx:id="messageLabel" styleClass="muted" wrapText="true" minHeight="-Infinity"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="billNoColumn" text="Bill No." prefWidth="80" styleClass="number-column"/>
            <TableColumn fx:id="dateColumn" text="Date and time" prefWidth="140"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="240"/>
            <TableColumn fx:id="itemsColumn" text="Items" prefWidth="60" styleClass="number-column"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="110" styleClass="number-column"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Esc = close" styleClass="muted" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelBillButton" text="Cancel bill…" styleClass="danger" onAction="#cancelSelected"
                minWidth="-Infinity"/>
        <Button fx:id="correctButton" text="Correct bill…" onAction="#correctSelected" minWidth="-Infinity"/>
        <Button fx:id="viewButton" text="See / print (Enter)" styleClass="primary" onAction="#viewSelected"
                minWidth="-Infinity"/>
        <Button text="Close" cancelButton="true" onAction="#close" minWidth="-Infinity"/>
    </HBox>
</VBox>
