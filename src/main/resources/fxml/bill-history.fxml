<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Bill history: find saved bills, see or reprint them, cancel (owner). Also used for one customer's bills. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.history.BillHistoryController"
      fx:id="root"
      styleClass="page"
      spacing="10">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="titleLabel" text="Bill history" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Today" onAction="#showToday" minWidth="-Infinity"/>
        <Button text="Yesterday" onAction="#showYesterday" minWidth="-Infinity"/>
        <Button text="This month" onAction="#showThisMonth" minWidth="-Infinity"/>
        <Button text="All dates" onAction="#showAllDates" minWidth="-Infinity"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="From" minWidth="-Infinity"/>
        <DatePicker fx:id="fromPicker" prefWidth="150" promptText="Any date"/>
        <Label text="To" minWidth="-Infinity"/>
        <DatePicker fx:id="toPicker" prefWidth="150" promptText="Any date"/>
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" styleClass="search-field"
                   promptText="Bill number, customer name, customer number or phone  (Ctrl+F)"/>
    </HBox>
    <Label fx:id="messageLabel" styleClass="muted" wrapText="true" minHeight="-Infinity"
           text="Type a bill number to find it on any date."/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="billNoColumn" text="Bill No." prefWidth="80" styleClass="number-column"/>
            <TableColumn fx:id="dateColumn" text="Date and time" prefWidth="150"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="250"/>
            <TableColumn fx:id="itemsColumn" text="Items" prefWidth="60" styleClass="number-column"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="110" styleClass="number-column"/>
            <TableColumn fx:id="paidColumn" text="Paid" prefWidth="110" styleClass="number-column"/>
            <TableColumn fx:id="khataColumn" text="On khata" prefWidth="110" styleClass="number-column"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="countLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="viewButton" text="See / reprint (Enter)" styleClass="primary" onAction="#viewSelected"
                minWidth="-Infinity"/>
        <Button fx:id="cancelBillButton" text="Cancel bill…" styleClass="danger" onAction="#cancelSelected"
                minWidth="-Infinity"/>
    </HBox>
</VBox>
