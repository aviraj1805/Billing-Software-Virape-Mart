<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Import products from a CSV file saved from Excel. Shows a preview before saving anything. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.products.ProductImportController"
      styleClass="dialog"
      spacing="12"
      prefWidth="1000"
      prefHeight="640">

    <Label styleClass="help-box" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"
           text="1.  Open your product list in Excel. The first row must have column names.&#10;2.  Needed columns: Name, Unit (kg, litre or pcs) and Rate. Optional: Marathi Name, Category, Pack Size, MRP.&#10;3.  In Excel choose File, then Save As, and pick &quot;CSV UTF-8 (Comma delimited)&quot;.&#10;4.  Click &quot;Choose file&quot; below and check the preview. Nothing is saved until you click Import.&#10;Products that are already in the list are skipped. An import never changes existing products."/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="chooseButton" text="Choose file…" styleClass="primary" onAction="#chooseFile"/>
        <Button fx:id="templateButton" text="Save blank template…" onAction="#saveTemplate"/>
        <Label fx:id="fileLabel" styleClass="muted"/>
    </HBox>

    <TableView fx:id="previewTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="rowColumn" text="Row" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="170"/>
            <TableColumn fx:id="nameMrColumn" text="Marathi name" prefWidth="130"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="130"/>
            <TableColumn fx:id="unitColumn" text="Unit" prefWidth="60"/>
            <TableColumn fx:id="packColumn" text="Pack size" prefWidth="75"/>
            <TableColumn fx:id="rateColumn" text="Rate" prefWidth="70"/>
            <TableColumn fx:id="mrpColumn" text="MRP" prefWidth="60"/>
            <TableColumn fx:id="statusColumn" text="What will happen" prefWidth="250"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="summaryLabel" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Hover over a row to read its full message." styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" text="Close" cancelButton="true" onAction="#close" minWidth="-Infinity"/>
        <Button fx:id="importButton" text="Import" styleClass="primary" disable="true" onAction="#doImport"
                minWidth="-Infinity"/>
    </HBox>
</VBox>
