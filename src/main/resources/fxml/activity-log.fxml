<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Activity log (owner): the audit records of rate changes, cancelled bills, edits, settings and backups. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.virpemart.billing.ui.history.ActivityLogController"
      styleClass="page"
      spacing="10">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Activity log" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Today" onAction="#showToday" minWidth="-Infinity"/>
        <Button text="Last 7 days" onAction="#showLastWeek" minWidth="-Infinity"/>
        <Button text="All dates" onAction="#showAllDates" minWidth="-Infinity"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="From" minWidth="-Infinity"/>
        <DatePicker fx:id="fromPicker" prefWidth="150" promptText="Any date"/>
        <Label text="To" minWidth="-Infinity"/>
        <DatePicker fx:id="toPicker" prefWidth="150" promptText="Any date"/>
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" styleClass="search-field"
                   promptText="Search, for example a bill number, product or customer name"/>
    </HBox>
    <Label fx:id="messageLabel" styleClass="muted" wrapText="true" minHeight="-Infinity"
           text="Every change to rates, bills, products, customers, settings and backups is recorded here. Records cannot be changed or deleted."/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="timeColumn" text="Date and time" prefWidth="150"/>
            <TableColumn fx:id="whatColumn" text="What" prefWidth="200"/>
            <TableColumn fx:id="detailsColumn" text="Details" prefWidth="560"/>
            <TableColumn fx:id="byColumn" text="By" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="countLabel" styleClass="muted"/>
</VBox>
